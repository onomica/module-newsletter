export default "{#\n  Copyright (c) 2026 Onomica\n  Licensed under the MIT License.\n#}\n\n<sw-page class=\"onomica-newsletter-detail\">\n    <template #smart-bar-back>\n        <router-link :to=\"{ name: 'onomica.newsletter.index' }\">\n            <sw-icon name=\"regular-chevron-left\" small />\n        </router-link>\n    </template>\n\n    <template #smart-bar-header>\n        <h2>{{ campaign ? campaign.name || $tc('onomica-newsletter.detail.newCampaign') : '' }}</h2>\n    </template>\n\n    <template #smart-bar-actions>\n        <sw-button\n            v-if=\"campaign && isEditable && !isNew\"\n            :disabled=\"isSaving\"\n            @click=\"schedule\"\n        >\n            {{ $tc('onomica-newsletter.detail.schedule') }}\n        </sw-button>\n        <sw-button\n            v-if=\"campaign && isEditable && !isNew\"\n            :disabled=\"isSaving\"\n            @click=\"sendNow\"\n        >\n            {{ $tc('onomica-newsletter.detail.sendNow') }}\n        </sw-button>\n        <sw-button\n            v-if=\"canCancel\"\n            :disabled=\"isSaving\"\n            @click=\"cancel\"\n        >\n            {{ $tc('onomica-newsletter.detail.cancel') }}\n        </sw-button>\n        <sw-button\n            v-if=\"canRetry\"\n            :disabled=\"isSaving\"\n            @click=\"retry\"\n        >\n            {{ $tc('onomica-newsletter.detail.retry') }}\n        </sw-button>\n        <sw-button-process\n            v-if=\"isEditable\"\n            v-model:process-success=\"isSaveSuccessful\"\n            variant=\"primary\"\n            :is-loading=\"isSaving\"\n            :disabled=\"isSaving\"\n            @click=\"save\"\n        >\n            {{ $tc('onomica-newsletter.detail.save') }}\n        </sw-button-process>\n    </template>\n\n    <template #content>\n        <sw-card-view v-if=\"campaign\">\n            <sw-card :title=\"$tc('onomica-newsletter.detail.general')\" :is-loading=\"isLoading\">\n                <sw-container columns=\"1fr 1fr\" gap=\"24px\">\n                    <sw-text-field\n                        v-model:value=\"campaign.name\"\n                        :label=\"$tc('onomica-newsletter.detail.name')\"\n                        :disabled=\"!isEditable\"\n                        required\n                    />\n                    <sw-text-field\n                        :value=\"$tc(`onomica-newsletter.status.${campaign.status}`)\"\n                        :label=\"$tc('onomica-newsletter.detail.status')\"\n                        disabled\n                    />\n                    <sw-entity-single-select\n                        v-model:value=\"campaign.salesChannelId\"\n                        entity=\"sales_channel\"\n                        label-property=\"name\"\n                        :label=\"$tc('onomica-newsletter.detail.salesChannel')\"\n                        :disabled=\"!isEditable\"\n                        required\n                    />\n                    <sw-entity-single-select\n                        v-model:value=\"campaign.languageId\"\n                        entity=\"language\"\n                        label-property=\"name\"\n                        :label=\"$tc('onomica-newsletter.detail.language')\"\n                        :disabled=\"!isEditable\"\n                        required\n                    />\n                </sw-container>\n            </sw-card>\n\n            <sw-card :title=\"$tc('onomica-newsletter.detail.message')\">\n                <sw-text-field\n                    v-model:value=\"campaign.subject\"\n                    :label=\"$tc('onomica-newsletter.detail.subject')\"\n                    :disabled=\"!isEditable\"\n                    required\n                />\n                <sw-text-field\n                    v-model:value=\"campaign.previewText\"\n                    :label=\"$tc('onomica-newsletter.detail.previewText')\"\n                    :disabled=\"!isEditable\"\n                />\n                <sw-container columns=\"1fr 1fr\" gap=\"24px\">\n                    <sw-text-field\n                        v-model:value=\"campaign.senderName\"\n                        :label=\"$tc('onomica-newsletter.detail.senderName')\"\n                        :help-text=\"$tc('onomica-newsletter.detail.senderNameHelp')\"\n                        :disabled=\"!isEditable\"\n                    />\n                    <sw-text-field\n                        v-model:value=\"campaign.senderEmail\"\n                        type=\"email\"\n                        :label=\"$tc('onomica-newsletter.detail.senderEmail')\"\n                        :help-text=\"$tc('onomica-newsletter.detail.senderEmailHelp')\"\n                        :disabled=\"!isEditable\"\n                    />\n                </sw-container>\n                <sw-textarea-field\n                    v-model:value=\"campaign.contentHtml\"\n                    :label=\"$tc('onomica-newsletter.detail.contentHtml')\"\n                    :help-text=\"$tc('onomica-newsletter.detail.templateHelp')\"\n                    :disabled=\"!isEditable\"\n                    rows=\"16\"\n                    required\n                />\n                <sw-textarea-field\n                    v-model:value=\"campaign.contentPlain\"\n                    :label=\"$tc('onomica-newsletter.detail.contentPlain')\"\n                    :help-text=\"$tc('onomica-newsletter.detail.plainHelp')\"\n                    :disabled=\"!isEditable\"\n                    rows=\"8\"\n                />\n            </sw-card>\n\n            <sw-card :title=\"$tc('onomica-newsletter.detail.delivery')\">\n                <sw-datepicker\n                    v-model:value=\"campaign.scheduledAt\"\n                    date-type=\"datetime\"\n                    :label=\"$tc('onomica-newsletter.detail.scheduledAt')\"\n                    :disabled=\"!isEditable\"\n                />\n                <sw-container columns=\"repeat(4, 1fr)\" gap=\"24px\">\n                    <sw-number-field :value=\"campaign.recipientCount\" :label=\"$tc('onomica-newsletter.detail.recipientCount')\" disabled />\n                    <sw-number-field :value=\"campaign.sentCount\" :label=\"$tc('onomica-newsletter.detail.sentCount')\" disabled />\n                    <sw-number-field :value=\"campaign.failedCount\" :label=\"$tc('onomica-newsletter.detail.failedCount')\" disabled />\n                    <sw-number-field :value=\"campaign.skippedCount\" :label=\"$tc('onomica-newsletter.detail.skippedCount')\" disabled />\n                </sw-container>\n            </sw-card>\n\n            <sw-card v-if=\"deliveries && deliveries.length\" :title=\"$tc('onomica-newsletter.detail.deliveries')\">\n                <sw-data-grid\n                    :data-source=\"deliveries\"\n                    :columns=\"deliveryColumns\"\n                    :show-actions=\"false\"\n                    :show-selection=\"false\"\n                >\n                    <template #column-status=\"{ item }\">\n                        {{ $tc(`onomica-newsletter.deliveryStatus.${item.status}`) }}\n                    </template>\n                    <template #column-sentAt=\"{ item }\">\n                        {{ item.sentAt ? dateFilter(item.sentAt) : '—' }}\n                    </template>\n                </sw-data-grid>\n            </sw-card>\n        </sw-card-view>\n    </template>\n</sw-page>\n";